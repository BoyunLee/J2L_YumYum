TZ=Asia/Seoul

MYSQL_DATABASE=yumyum
MYSQL_USER=ssafy
MYSQL_PASSWORD=ssafy
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3307

BACKEND_PORT=8080
FRONTEND_PORT=5173
PORORO_OCR_PORT=8001

COMPANY_ORIGIN_URL=http://localhost:5173
COMPANY_TEMP_URL=http://localhost
COMPANY_TEMP_URL_PORT=http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080

# mock: 외부 API를 호출하지 않고 데모 데이터를 사용합니다.
# fallback: 실API를 먼저 호출하고 실패하면 데모 데이터로 전환합니다.
# live: 실API만 사용합니다. API 키 누락/실패 시 오류를 반환합니다.
INTEGRATION_MODE=mock

JWT_ISSUER=J2L_yumyum
JWT_SECRET_KEY=
JWT_ACCESS_EXPIRED_AT=3600000
JWT_REFRESH_EXPIRED_AT=604800000

# admin_users가 비어 있을 때 최초 관리자 1명을 생성합니다.
# 최초 생성 후 ADMIN_BOOTSTRAP_ENABLED=false로 되돌리는 것을 권장합니다.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_LOGIN_ID=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_ROLE=SUPER_ADMIN

GMS_API_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1/chat/completions
GMS_API_MODEL=gpt-5-nano
GMS_API_KEY=
GMS_KEY=
PORORO_OCR_URL=http://pororo-ocr:8000/ocr
PORORO_OCR_LANG=ko

FOOD_SAFETY_API_BASE_URL=http://openapi.foodsafetykorea.go.kr/api
FOOD_SAFETY_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
